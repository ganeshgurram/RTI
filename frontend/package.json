{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "api:dev": "node --env-file=.env.local --watch server/local.js",
    "api:start": "node --env-file=.env.local server/local.js",
    "api:check": "node --check server/local.js && node --check server/app.js && node --check server/db.js && node --check server/seed.js && node --check server/middleware/auth.js && node --check server/middleware/errors.js && node --check server/services/sessions.js && node --check server/services/notifications.js && node --check server/routes/auth.js && node --check server/routes/health.js && node --check server/routes/profile.js && node --check server/routes/requests.js && node --check server/routes/payments.js && node --check server/routes/notifications.js && node --check server/routes/voice.js",
    "predev": "node scripts/ensure-dependencies.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-dependencies.mjs",
    "build": "tsc -b && vite build",
    "prelint": "node scripts/ensure-dependencies.mjs",
    "lint": "oxlint",
    "eval:authorities": "node --experimental-strip-types --no-warnings scripts/eval-authority-recommendations.mjs",
    "eval:privacy": "node --no-warnings scripts/eval-privacy-filter.mjs",
    "eval:deadlines": "node --experimental-strip-types --no-warnings scripts/eval-deadlines.mjs",
    "check:i18n": "node --no-warnings scripts/check-translations.mjs",
    "preview": "vite preview",
    "build:manual": "node scripts/build-user-manual.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-kannada": "^5.3.0",
    "@fontsource-variable/noto-sans-telugu": "^5.3.0",
    "@google/genai": "^2.21.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "i18next": "^26.4.0",
    "lucide-react": "^1.34.0",
    "mongodb": "^6.18.0",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
