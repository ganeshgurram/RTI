# Local development only. Copy this file to .env.local.
# Never commit .env.local and never use VITE_ prefixes for server-only values.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:free
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/rti?retryWrites=true&w=majority
PORT=8787
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=true

# Optional local fallback when DNS SRV records for MongoDB Atlas are unavailable.
MONGODB_DIRECT_HOSTS=
MONGODB_REPLICA_SET=
