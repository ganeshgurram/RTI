# Local development only. Copy this file to .env.local.
# Never commit .env.local and never use VITE_ prefixes for server-only values.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m2.7:free
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Voice replies use Fish Audio through OpenRouter with automatic language detection.
VOICE_TTS_MODEL=fish-audio/s2.1-pro-free:free
VOICE_TTS_VOICE=alloy
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/rti?retryWrites=true&w=majority
PORT=8787
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=true

# Optional local fallback when DNS SRV records for MongoDB Atlas are unavailable.
MONGODB_DIRECT_HOSTS=
MONGODB_REPLICA_SET=
